PROFITLAB_DATA_DIR=./data
PROFITLAB_HOST=127.0.0.1
PROFITLAB_PORT=8000
SEC_USER_AGENT=ProfitLab/0.1 your-real-contact-email@example.com
SEC_REQUESTS_PER_SECOND=2
SEC_TIMEOUT=15
SEC_TOTAL_TIMEOUT=120
SEC_RETRIES=2
SEC_MAX_HISTORY_FILES=20
SEC_MAX_RESPONSE_BYTES=20000000
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5.6-luna
# Chat Completions function tools on gpt-5.6-luna require reasoning disabled
LLM_REASONING_EFFORT=none
LLM_OUTPUT_MODE=tool
JEV_CONCURRENCY=2
LLM_CONCURRENCY=1
CHUNK_TARGET_TOKENS=1500
CHUNK_OVERLAP_TOKENS=180
MAX_HTTP_ATTEMPTS=3

# Separate transport and structured-output budgets for provider probes
PROVIDER_TIMEOUT=30
PROVIDER_TOTAL_TIMEOUT=120
PROVIDER_MAX_RESPONSE_BYTES=2000000
STRUCTURED_OUTPUT_REPAIRS=1

# Experimental relevance policy and bounded recovery (T08)
SCREEN_KEEP_THRESHOLD=0.65
SCREEN_UNCERTAIN_THRESHOLD=0.20
SCREEN_MAX_REQUESTS=100
SCREEN_RECOVERY_MAX_CHUNKS=12
